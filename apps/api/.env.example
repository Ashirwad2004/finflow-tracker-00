# FastAPI Settings
PROJECT_NAME="FinFlow SaaS API"
API_V1_STR=/api/v1
ENVIRONMENT=development
SHOW_DOCS=true
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8080"]

# Gemini AI Integration Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048

# Model tiers. A client may only request one of these (or the tier names
# "fast" / "deep" / "vision"); anything else falls back to GEMINI_MODEL, so
# nobody can bill an arbitrary model through the API.
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
GEMINI_DEEP_MODEL=gemini-2.5-pro
GEMINI_VISION_MODEL=gemini-2.5-flash
# Comma-separated extras to add to the allowlist.
GEMINI_EXTRA_ALLOWED_MODELS=

# Hard ceiling for any single generation.
GEMINI_OUTPUT_TOKEN_CEILING=16384
# Floor applied when the provider's default thinking budget is in play. Thinking
# tokens are drawn from the same ceiling as the answer, so without headroom a
# thinking model can spend its whole budget and return nothing.
GEMINI_THINKING_HEADROOM_TOKENS=2048
# Thinking budget for the grounded CFO agent (0 disables it on flash models).
GEMINI_AGENT_THINKING_BUDGET=1024

# Rate limits. These are the slowapi per-IP backstops; the per-user limits and
# the daily token budget live in src/modules/ai/usage.py.
AI_RATE_LIMIT=30/minute
AI_CHAT_RATE_LIMIT=20/minute
AI_AUTH_REQUIRED=true

# Provider retries. Only transient failures (429/5xx/timeout) are retried.
AI_MAX_ATTEMPTS=3
AI_RETRY_BASE_DELAY=1.0

# Per-user daily token allowance; 0 disables budget enforcement. Requires the
# ai_usage_events table (supabase/migrations/20261006000000_ai_engine.sql).
AI_DAILY_TOKEN_BUDGET=400000

# Maximum tool-calling rounds per chat turn.
AI_MAX_TOOL_ROUNDS=6
# Cache window for deterministic insight generations.
AI_INSIGHT_CACHE_SECONDS=900
# The generic /ai/completions passthrough. Off by default -- every client uses
# the typed, grounded endpoints, and the route returns 410 when disabled so a
# stale cached bundle fails loudly instead of silently degrading.
AI_ALLOW_RAW_COMPLETIONS=false

# Supabase Auth and Database Settings
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
VITE_SUPABASE_URL=your_supabase_project_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Payment Gateway Settings
PAYMENT_GATEWAY_PROVIDER=razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# WhatsApp / OpenWA Gateway Settings
OPENWA_BASE_URL=http://localhost:2785
OPENWA_ADMIN_API_KEY=your_openwa_admin_api_key_here
OPENWA_TIMEOUT_SECONDS=15
OPENWA_WEBHOOK_SECRET=your_openwa_webhook_secret_here
WHATSAPP_PROVIDER=openwa

