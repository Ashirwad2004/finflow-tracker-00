{
  "include": ["src", "tests"],
  "executionEnvironments": [
    {
      "root": "src",
      "extraPaths": [".", ".."]
    },
    {
      "root": "tests",
      "extraPaths": [".", ".."]
    }
  ],
  "extraPaths": ["."],
  "venvPath": ".",
  "venv": "venv",
  "pythonVersion": "3.11",
  "typeCheckingMode": "basic",
  "reportMissingModuleSource": "none"
}
