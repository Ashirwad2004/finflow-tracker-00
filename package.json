{
  "name": "finflow-tracker-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "FinFlow Tracker - Full-stack application with FastAPI backend and React Vite frontend",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=frontend\" \"python run-backend.py\"",
    "frontend:dev": "npm run dev --workspace=frontend",
    "backend:dev": "python run-backend.py",
    "test:backend": "pytest backend/tests -v",
    "build": "npm run build --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "preview": "npm run preview --workspace=frontend",
    "server": "node frontend/server.js",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "pytest": "^1.0.0"
  }
}
